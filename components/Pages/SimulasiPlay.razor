@page "/simulasi/play"
@inject IJSRuntime JS
@inject AuthService Auth
@inject NavigationManager Nav

<div style="width:100%;height:calc(100vh - 4rem);border:none;position:relative;">
    <iframe src="@_iframeSrc"
            style="width:100%;height:100%;border:none;"
            allow="xr-spatial-tracking; microphone">
    </iframe>

    <!-- Back button overlay -->
    <div style="position:absolute;top:12px;left:12px;z-index:20;pointer-events:auto;">
        <a href="/simulasi" style="
            background:rgba(0,0,0,0.6);backdrop-filter:blur(8px);
            color:#fff;border:none;border-radius:999px;
            padding:8px 16px;font-size:0.85rem;font-weight:600;
            text-decoration:none;display:inline-flex;align-items:center;gap:6px;
            border:1px solid rgba(255,255,255,0.08);
        ">← Kembali</a>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Vehicle { get; set; }
    [SupplyParameterFromQuery] public string? Transmission { get; set; }

    private string _iframeSrc = "/simulation-3d/index.html";

    protected override void OnInitialized()
    {
        var vehicle = Vehicle ?? "MOBIL";
        var trans = Transmission ?? "automatic";
        _iframeSrc = $"/simulation-3d/index.html?vehicle={vehicle}&transmission={trans}";
    }
}
