{
  "name": "kemudi-id",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd src/Kemudi.App && dotnet run",
    "dev:next": "next dev -H 0.0.0.0 -p 3000",
    "dev:https": "cd src/Kemudi.App && dotnet run --urls https://localhost:5001;http://localhost:5000",
    "build": "cd src/Kemudi.App && dotnet build",
    "start": "cd src/Kemudi.App && dotnet run --no-build --urls http://0.0.0.0:5000",
    "start:next": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint",
    "dotnet:app": "cd src/Kemudi.App && dotnet run",
    "dotnet:web": "cd src/Kemudi.Web && dotnet run",
    "dotnet:api": "cd src/Kemudi.Api && dotnet run",
    "dotnet:build": "dotnet build Kemudi.slnx"
  },
  "dependencies": {
    "@pmndrs/xr": "^6.6.30",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/rapier": "^2.2.0",
    "@react-three/xr": "^6.6.30",
    "@types/three": "^0.185.1",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
