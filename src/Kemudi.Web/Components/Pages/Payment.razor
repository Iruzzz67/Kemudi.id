@page "/kursus/payment"
@using Kemudi.Shared.DTOs
@using Kemudi.Web.Services
@inject ApiClient Api
@inject NavigationManager Nav
@inject IConfiguration Configuration

@if (_loading)
{
    <div class="loading">Memuat instruksi pembayaran...</div>
}
else if (_registration is null)
{
    <div class="empty">Pendaftaran tidak ditemukan atau tidak dapat diakses. <a href="/login">Masuk dengan akun pemilik</a> atau <a href="/kursus">kembali ke kursus</a>.</div>
}
else if (_statusUnavailable)
{
    <div class="error-box" role="alert">Status pembayaran belum dapat dipastikan. Jangan mengulang transfer. <a href="@Nav.Uri">Muat ulang status</a> atau hubungi admin untuk rekonsiliasi.</div>
}
else
{
    <div style="padding-top:1rem;">
        <div class="section-head">
            <div>
                <h1 class="section-title" style="font-size:2rem;">Instruksi Pembayaran</h1>
                <p class="section-sub" style="font-size:1.05rem;">Pembayaran diperiksa manual. Pengajuan tidak otomatis melunasi atau mengaktifkan kursus.</p>
            </div>
        </div>

        <div class="two-col mt-3">
            <div class="card" style="padding:2rem;">
                <h3 style="font-size:1.15rem; font-weight:800; margin-bottom:1.25rem;">Detail Pendaftaran</h3>
                <div class="list-item"><span class="muted">Nama</span><br /><strong style="font-size:1.05rem;">@_registration.Name</strong></div>
                <div class="list-item"><span class="muted">Metode</span><br /><strong>@MethodLabel(_registration.PaymentMethod)</strong></div>
                <div class="list-item"><span class="muted">Mulai Kursus</span><br /><strong>@_registration.StartDate.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                <div class="list-item"><span class="muted">Jumlah</span><br /><span class="price" style="font-size:1.5rem;">Rp @((_payment?.Amount ?? _registration.Amount).ToString("N0", new System.Globalization.CultureInfo("id-ID")))</span></div>
            </div>

            <div class="card" style="padding:2rem;">
                <h3 style="font-size:1.15rem; font-weight:800; margin-bottom:1.25rem;">@MethodLabel(_registration.PaymentMethod)</h3>

                @if (_payment is not null || _registration.Status != "pending")
                {
                    <div class="payment-box" role="status">
                        @if ((_payment?.Status ?? _registration.Status) == "paid")
                        {
                            <p>Pembayaran tercatat lunas.</p>
                        }
                        else if (_payment?.Status == "pending")
                        {
                            <p>Pengajuan diterima. Menunggu verifikasi penerimaan dana oleh admin; kursus belum diaktifkan.</p>
                        }
                        else
                        {
                            <p>Pendaftaran atau pembayaran ditolak/dibatalkan. Hubungi admin melalui kanal resmi untuk peninjauan.</p>
                        }
                    </div>
                }
                else if (_registration.PaymentMethod != "cash")
                {
                    @if (string.IsNullOrWhiteSpace(Instructions))
                    {
                        <p role="alert">Metode pembayaran ini belum dikonfigurasi. Jangan transfer ke rekening atau QR contoh. Hubungi admin melalui kanal resmi.</p>
                    }
                    else
                    {
                        <p class="payment-box" style="white-space:pre-line">@Instructions</p>
                        <div class="field">
                            <label for="payment-reference">Referensi transfer / transaksi</label>
                            <input id="payment-reference" maxlength="128" minlength="3" @bind="_reference" aria-describedby="payment-reference-help" />
                            <p id="payment-reference-help" class="muted">Referensi ini hanya untuk pencocokan admin, bukan bukti dana sudah diterima. Jangan kirim PIN, OTP atau data kartu.</p>
                        </div>
                    }
                }
                else
                {
                    <div class="payment-box">
                        <p>Bayar di tempat saat verifikasi pada tanggal:</p>
                        <p style="font-weight:700;">@_registration.StartDate.ToLocalTime().ToString("dd MMM yyyy")</p>
                        <p class="muted">Jumlah: <strong style="color:var(--blue);">Rp @_registration.Amount.ToString("N0", new System.Globalization.CultureInfo("id-ID"))</strong></p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="error-box mt-2">@_error</div>
                }

                @if (_payment is null && _registration.Status == "pending")
                {
                    <div class="flex mt-3">
                        <button class="btn btn-primary btn-lg" disabled="@(_busy || (_registration.PaymentMethod != "cash" && string.IsNullOrWhiteSpace(Instructions)))" @onclick="ConfirmAsync">@(_busy ? "Mengirim..." : "Ajukan verifikasi pembayaran")</button>
                        <a class="btn btn-outline" href="/kursus">Kembali</a>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter, SupplyParameterFromQuery] public string? Registration { get; set; }

    private CourseRegistrationDto? _registration;
    private PaymentDto? _payment;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string _reference = "";
    private bool _statusUnavailable;
    private string? Instructions => Configuration[_registration?.PaymentMethod == "e-wallet"
        ? "Payments:EWalletInstructions" : "Payments:TransferInstructions"];

    private static string MethodLabel(string method) => method switch
    {
        "transfer" => "Transfer Bank",
        "e-wallet" => "E-Wallet / QRIS",
        "cash" => "Bayar di Tempat",
        _ => method
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Guid.TryParse(Registration, out var id) || id == Guid.Empty)
        {
            _loading = false;
            return;
        }

        try
        {
            _registration = await Api.GetAsync<CourseRegistrationDto>($"/api/course-registration/{id}");
            if (_registration is not null)
            {
                var payment = await Api.GetWithStatusAsync<PaymentDto>($"/api/payment/{id}");
                if (payment.Status == System.Net.HttpStatusCode.OK && payment.Data is not null)
                    _payment = payment.Data;
                else if (payment.Status != System.Net.HttpStatusCode.NotFound)
                    _statusUnavailable = true;
            }
        }
        catch (Exception error) when (error is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            _statusUnavailable = true;
        }
        finally { _loading = false; }
    }

    private async Task ConfirmAsync()
    {
        if (_registration is null || _payment is not null) return;
        _busy = true;
        _error = null;
        try
        {
            var method = _registration.PaymentMethod;
            if (method != "cash" && (string.IsNullOrWhiteSpace(Instructions) || _reference.Trim().Length < 3))
            {
                _error = "Gunakan instruksi resmi dan isi referensi transaksi minimal 3 karakter.";
                return;
            }
            var result = await Api.PostAsync<PaymentRequest, PaymentDto>(
                "/api/payment",
                new PaymentRequest(_registration.Id, method, method == "cash" ? null : _reference.Trim()));

            if (result is null)
            {
                _error = "Pengajuan tidak dapat diproses. Muat ulang status; jika sudah ditolak atau referensi berbeda, hubungi admin.";
                return;
            }

            _payment = result;
        }
        finally
        {
            _busy = false;
        }
    }
}
