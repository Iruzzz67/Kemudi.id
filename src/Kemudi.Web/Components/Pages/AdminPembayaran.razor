@page "/admin/pembayaran"
@layout Kemudi.Web.Components.Layout.AdminLayout
@using System.Globalization
@using Kemudi.Shared.DTOs
@using Kemudi.Web.Services
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav

<h1 class="page-title">Verifikasi Pembayaran</h1>
<p class="page-sub">Cocokkan dana yang benar-benar diterima dan nominalnya melalui rekening/provider resmi atau kuitansi tunai. Referensi pelanggan bukan bukti pelunasan.</p>

@if (_error is not null)
{
    <div class="error-box">@_error</div>
}

<div class="admin-panel">
    <div class="admin-toolbar">
        <select value="@_statusFilter" @onchange="OnFilter">
            <option value="">Semua Status</option>
            <option value="pending">Pending</option>
            <option value="paid">Berhasil</option>
            <option value="cancelled">Ditolak</option>
        </select>
        <span class="admin-count">@_payments.Count transaksi</span>
    </div>

    @if (_verifying is Guid verifyingId && _payments.FirstOrDefault(p => p.Id == verifyingId) is { Status: "pending" } selected)
    {
        <form id="payment-verification" class="card" style="padding:1.5rem;margin:1rem 0;"
              aria-labelledby="payment-verification-title" @onsubmit="@(() => SetStatus(selected, "paid"))" @onsubmit:preventDefault>
            <h2 id="payment-verification-title">Verifikasi penerimaan dana</h2>
            <p>@selected.RegistrantName — @PaymentMethodLabel(selected.Method) — @FormatRp(selected.Amount)</p>
            <div class="field">
                <label for="payment-verification-reference">Referensi penerimaan dana / kuitansi</label>
                <input id="payment-verification-reference" maxlength="128" @bind="_verificationReference" autofocus />
            </div>
            <label class="flex"><input type="checkbox" @bind="_reconciled" /> Saya sudah mencocokkan penerimaan dana dan nominal di atas pada sumber resmi.</label>
            <div class="flex mt-2">
                <button type="submit" class="btn btn-success" disabled="@(_busy || !_reconciled || _verificationReference.Trim().Length < 3)">Konfirmasi penerimaan dana</button>
                <button type="button" class="btn btn-outline" disabled="@_busy" @onclick="@(() => _verifying = null)">Batal verifikasi</button>
            </div>
        </form>
    }

    @if (_loading)
    {
        <div class="loading">Memuat data...</div>
    }
    else if (_payments.Count == 0)
    {
        <p class="empty">Tidak ada pembayaran.</p>
    }
    else
    {
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>Tanggal</th><th>Peserta</th><th>Metode</th><th>Nominal</th><th>Status</th><th>Aksi</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in _payments)
                    {
                        <tr>
                            <td>@p.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm", CultureInfo.GetCultureInfo("id-ID"))</td>
                            <td><strong>@p.RegistrantName</strong><br /><span class="muted">@p.RegistrantEmail</span></td>
                            <td>@PaymentMethodLabel(p.Method)<br /><span class="muted">Referensi: @(p.Reference ?? "—")</span></td>
                            <td>@FormatRp(p.Amount)</td>
                            <td><AdminBadge Value="@p.Status" /></td>
                            <td>
                                <div class="admin-actions">
                                    @if (p.Status == "pending" && _verifying != p.Id)
                                    {
                                        <button class="btn btn-success" disabled="@_busy" @onclick="@(() => BeginVerification(p))">Verifikasi</button>
                                    }
                                    @if (p.Status == "pending")
                                    {
                                        <button class="btn btn-outline" style="color:#dc2626;border-color:#fecaca" disabled="@_busy" @onclick="@(() => SetStatus(p, "cancelled"))">Tolak</button>
                                    }
                                    @if (p.Status == "cancelled")
                                    {
                                        <button class="btn btn-outline" disabled="@_busy" @onclick="@(() => SetStatus(p, "pending"))">Buka pengajuan</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private List<AdminPaymentDto> _payments = new();
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string _statusFilter = "";
    private Guid? _verifying;
    private string _verificationReference = "";
    private bool _reconciled;

    private void BeginVerification(AdminPaymentDto payment)
    {
        _verifying = payment.Id;
        _verificationReference = "";
        _reconciled = false;
    }

    private async Task SetStatus(AdminPaymentDto p, string status)
    {
        if (_busy) return;
        if (status == "paid" && (_verifying != p.Id || !_reconciled || _verificationReference.Trim().Length < 3))
        {
            _error = "Cocokkan penerimaan dana dan isi referensi sebelum mengonfirmasi.";
            return;
        }
        _busy = true;
        _error = null;
        try
        {
            var result = await Api.PatchVoidAsync($"/api/admin/payments/{p.Id}",
                new AdminPaymentUpdateRequest(status, status == "paid" ? _verificationReference.Trim() : null));
            await Load();
            if (!result.Success) _error = result.Error;
            else _verifying = null;
        }
        catch (Exception error) when (error is HttpRequestException or TaskCanceledException)
        {
            _error = "Status belum terkonfirmasi. Muat ulang dan periksa sebelum mencoba kembali.";
        }
        finally { _busy = false; }
    }

    private void OnFilter(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "";
        _ = Load();
    }

    private async Task Load()
    {
        _loading = true;
        _error = null;
        var path = "/api/admin/payments" + (string.IsNullOrEmpty(_statusFilter) ? "" : $"?status={_statusFilter}");
        _payments = await Api.GetAsync<List<AdminPaymentDto>>(path) ?? new();
        _loading = false;
    }

    private static string FormatRp(decimal amount) => $"Rp {amount.ToString("N0", CultureInfo.GetCultureInfo("id-ID"))}";

    private static string PaymentMethodLabel(string method) => method switch
    {
        "transfer" => "Transfer Bank",
        "e-wallet" => "E-Wallet / QRIS",
        "cash" => "Bayar di Tempat",
        _ => method
    };

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated || !Auth.IsAdmin)
        {
            Nav.NavigateTo("/admin/login", forceLoad: true);
            return;
        }
        await Load();
    }
}
