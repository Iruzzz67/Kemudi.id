@page "/"
@using Kemudi.Web.Data
@using Kemudi.Web.Services
@using Kemudi.Shared.DTOs
@inject ApiClient Api

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-content">
        <div class="hero-badge">Kursus Mengemudi Online</div>
        <h1 class="hero-title">
            Belajar Nyetir,
            <br />Langsung di Browser
        </h1>
        <p class="hero-desc">
            Simulasi 3D motor, mobil, dan truk — fisika beneran, rute beneran.
            Coba gratis sebelum turun ke jalan.
        </p>
        <div class="hero-actions">
            <a class="btn btn-primary btn-xl" href="simulasi">
                Coba Simulasi
            </a>
            <a class="btn btn-outline btn-xl" href="kursus">
                Lihat Kursus
            </a>
        </div>
    </div>
    <div class="hero-visual">
        <div class="hero-vehicle-showcase">
            @if (_vehicles is not null)
            {
                @foreach (var v in _vehicles)
                {
                    <div class="hero-vehicle-card">
                        <div class="vehicle-icon">
                            @(v.Type == "MOTOR" ? "🏍️" : v.Type == "MOBIL" ? "🚗" : "🚛")
                        </div>
                        <div>
                            <strong>@v.Label</strong>
                            <div class="muted" style="font-size:0.85rem">@v.MaxSpeed m/s · @(v.GearCount) gigi</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- Stats Counter -->
<section class="stats-section">
    <div class="stats-grid">
        <div class="stat-item">
            <div class="stat-number">@_animatedStudents</div>
            <div class="stat-label">Murid Terdaftar</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">@_animatedSimulations</div>
            <div class="stat-label">Simulasi Selesai</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">@_animatedMentors</div>
            <div class="stat-label">Mentor Aktif</div>
        </div>
        <div class="stat-item">
            <div class="stat-number">@_animatedCourses</div>
            <div class="stat-label">Paket Kursus</div>
        </div>
    </div>
</section>

<!-- Vehicle Comparison -->
<section class="section" id="kendaraan">
    <div class="section-header">
        <h2>Kendaraan yang Tersedia</h2>
        <p>Fisika beda tiap kendaraan. Pilih yang mau dicoba.</p>
    </div>

    @if (_vehicles is not null)
    {
        <div class="vehicle-tabs">
            @foreach (var v in _vehicles)
            {
                <button class="vehicle-tab @(_selectedVehicle == v.Type ? "active" : "")"
                        @onclick="() => SelectVehicle(v.Type)">
                    @(v.Type == "MOTOR" ? "🏍️" : v.Type == "MOBIL" ? "🚗" : "🚛")
                    @v.Label
                </button>
            }
        </div>

        @if (_selectedVehicleData is not null)
        {
            <div class="vehicle-detail-card">
                <div class="vehicle-detail-header">
                    <div class="vehicle-detail-icon">
                        @(_selectedVehicleData.Type == "MOTOR" ? "🏍️" : _selectedVehicleData.Type == "MOBIL" ? "🚗" : "🚛")
                    </div>
                    <div>
                        <h3>@_selectedVehicleData.Label</h3>
                        <p>@_selectedVehicleData.Description</p>
                    </div>
                </div>
                <div class="vehicle-specs">
                    <div class="spec-item">
                        <span class="spec-value">@(_selectedVehicleData.MaxSpeed)</span>
                        <span class="spec-label">m/s max</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-value">@(_selectedVehicleData.MaxSpeed * 3.6).ToString("0")</span>
                        <span class="spec-label">km/j</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-value">@(_selectedVehicleData.GearCount)</span>
                        <span class="spec-label">Gigi</span>
                    </div>
                    <div class="spec-item">
                        <span class="spec-value">@(_selectedVehicleData.Type == "MOTOR" ? "Ringan" : _selectedVehicleData.Type == "MOBIL" ? "Sedang" : "Berat")</span>
                        <span class="spec-label">Kelas</span>
                    </div>
                </div>
                <div class="vehicle-actions">
                    <a class="btn btn-primary" href="simulasi">Coba Simulasi</a>
                    <a class="btn btn-outline" href="kursus">Lihat Kursus</a>
                </div>
            </div>
        }
    }
</section>

<!-- Features -->
<section class="section features-section">
    <div class="section-header">
        <h2>Fitur Utama</h2>
        <p>Yang bikin beda dari cuma baca buku teori.</p>
    </div>
    <div class="features-grid">
        <div class="feature-card">
            <div class="feature-icon">🎮</div>
            <h3>Simulasi 3D</h3>
            <p>Fisika kendaraan yang realistis — grip ban, transfer beban, dan respons suspensi.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🏍️</div>
            <h3>3 Kendaraan</h3>
            <p>Motor, mobil, truk — masing-masing punya handling yang beda. Harus adaptasi.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">👨‍🏫</div>
            <h3>Mentor Asli</h3>
            <p>Instruktur berpengalaman yang ngajarin beneran, bukan cuma teori.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">📋</div>
            <h3>Pre-Drive Check</h3>
            <p>Checklist kelengkapan kendaraan sebelum jalan — kebiasaan yang harus dibentuk.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">🚦</div>
            <h3>Rambu & Lalu Lintas</h3>
            <p>Traffic light, zebra cross, prioritas jalan — semuanya diuji di simulasi.</p>
        </div>
        <div class="feature-card">
            <div class="feature-icon">📊</div>
            <h3>Rekam Progres</h3>
            <p>Skor, pelanggaran, waktu tempuh — tahu di mana masih lemah.</p>
        </div>
    </div>
</section>

<!-- How It Works -->
<section class="section how-section">
    <div class="section-header">
        <h2>Langkah Awal</h2>
        <p>Empat langkah untuk mulai belajar.</p>
    </div>
    <div class="steps-grid">
        <div class="step-card">
            <div class="step-number">1</div>
            <h3>Daftar</h3>
            <p>Buat akun gratis. Isi nama sama email, selesai.</p>
        </div>
        <div class="step-arrow">→</div>
        <div class="step-card">
            <div class="step-number">2</div>
            <h3>Pilih Kendaraan</h3>
            <p>Motor, mobil, atau truk — mau mulai dari mana?</p>
        </div>
        <div class="step-arrow">→</div>
        <div class="step-card">
            <div class="step-number">3</div>
            <h3>Simulasi</h3>
            <p>Latihan di jalan virtual. Nabrak di sini gak ada denda.</p>
        </div>
        <div class="step-arrow">→</div>
        <div class="step-card">
            <div class="step-number">4</div>
            <h3>Praktik</h3>
            <p>Langsung ke jalanan beneran. Lebih siap dari yang belum coba.</p>
        </div>
    </div>
</section>

<!-- Testimonials -->
<section class="section testimonials-section">
    <div class="section-header">
        <h2>Cerita Mereka yang Sudah Coba</h2>
        <p>Pengalaman langsung dari pengguna.</p>
    </div>
    <div class="testimonials-grid">
        @foreach (var t in _testimonials)
        {
            <div class="testimonial-card">
                <div class="testimonial-stars">⭐⭐⭐⭐⭐</div>
                <p class="testimonial-text">"@t.Quote"</p>
                <div class="testimonial-author">
                    <div class="testimonial-avatar">@t.Initials</div>
                    <div>
                        <strong>@t.Name</strong>
                        <div class="muted">@t.Role</div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<!-- Materi Section -->
<section class="section">
    <div class="section-header">
        <div>
            <h2>Materi yang Tersedia</h2>
            <p>Baca dulu sebelum praktik. Supaya ngerti kenapa harus begitu.</p>
        </div>
        <a class="btn btn-outline" href="materi">Semua materi →</a>
    </div>
    <div class="materi-grid">
        @foreach (var m in MateriData.List.Take(4))
        {
            <a class="materi-card" href="materi/@m.Slug">
                <span class="materi-tag">@m.Category</span>
                <h3>@m.Title</h3>
                <p>@m.Summary</p>
                <span class="materi-link">Baca →</span>
            </a>
        }
    </div>
</section>

<!-- CTA -->
<section class="cta-section">
    <div class="cta-content">
        <h2>Mulai dari Sekarang</h2>
        <p>Simulasi gratis. Atau pilih kursus lengkap kalau mau bimbingan mentor.</p>
        <div class="cta-actions">
            <a class="btn btn-white btn-xl" href="simulasi">Coba Simulasi</a>
            <a class="btn btn-white btn-xl" href="kursus" style="border:1px solid rgba(255,255,255,0.3);background:transparent;color:#fff">Lihat Kursus</a>
        </div>
    </div>
</section>

@code {
    private List<VehicleDto>? _vehicles;
    private string? _selectedVehicle;
    private VehicleDto? _selectedVehicleData;

    private int _animatedStudents;
    private int _animatedSimulations;
    private int _animatedMentors;
    private int _animatedCourses;

    private record TestimonialItem(string Name, string Initials, string Role, string Quote, string Color);

    private readonly List<TestimonialItem> _testimonials = new()
    {
        new("Sarah A.", "SA", "Pemula Motor", "Awalnya takut banget nyetir motor. Setelah simulasi berkali-kali, sekarang udah berani ke kampus sendiri.", "#0a0a0a"),
        new("Doni P.", "DP", "Kursus Mobil", "Parkir paralel itu kayak seni. Diajarin triknya di sini, langsung nyambung pas praktik beneran.", "#0a0a0a"),
        new("Rina K.", "RK", "Kursus Mobil", "Simulasinya ngebangun reaksi. Pas tiba-tiba ada motor nyelip di jalan, udah nggak panik lagi.", "#0a0a0a"),
        new("Hendra S.", "HS", "Kursus Truk", "Mundur ke gang sempit pakai truk itu beda jauh sama mobil. Di sini bisa latihan tanpa risiko.", "#0a0a0a"),
        new("Putri N.", "PN", "Pemula Motor", "Materi rambu-rambunya lengkap. Sekarang hafal semua arti rambu, bukan cuma nebak-nebak.", "#0a0a0a"),
        new("Budi W.", "BW", "Kursus Mobil", "Pre-drive check list itu penting. Sekarang jadi kebiasaan sebelum jalan, bahkan di simulasi.", "#0a0a0a"),
    };

    protected override async Task OnInitializedAsync()
    {
        _vehicles = await Api.GetAsync<List<VehicleDto>>("/api/vehicles");
        if (_vehicles is { Count: > 0 })
        {
            _selectedVehicle = _vehicles[0].Type;
            _selectedVehicleData = _vehicles[0];
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await AnimateCounters();
        }
    }

    private void SelectVehicle(string type)
    {
        _selectedVehicle = type;
        _selectedVehicleData = _vehicles?.FirstOrDefault(v => v.Type == type);
    }

    private async Task AnimateCounters()
    {
        var targetStudents = 1250;
        var targetSimulations = 8400;
        var targetMentors = 12;
        var targetCourses = 7;

        var steps = 30;
        var delay = 30;

        for (int i = 1; i <= steps; i++)
        {
            var progress = (double)i / steps;
            var eased = 1 - Math.Pow(1 - progress, 3);

            _animatedStudents = (int)(targetStudents * eased);
            _animatedSimulations = (int)(targetSimulations * eased);
            _animatedMentors = (int)(targetMentors * eased);
            _animatedCourses = (int)(targetCourses * eased);

            await InvokeAsync(StateHasChanged);
            await Task.Delay(delay);
        }
    }
}
