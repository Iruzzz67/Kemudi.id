@page "/admin/mentor"
@layout Kemudi.Web.Components.Layout.AdminLayout
@using System.Globalization
@using Kemudi.Shared.DTOs
@using Kemudi.Web.Services
@inject ApiClient Api
@inject AuthService Auth
@inject NavigationManager Nav

<h1 class="page-title">Manajemen Mentor</h1>
<p class="page-sub">Kelola data mentor kursus.</p>

@if (_error is not null)
{
    <div class="error-box">@_error</div>
}

<div class="admin-panel">
    <div class="admin-toolbar">
        <span class="admin-count">@_mentors.Count mentor</span>
        <span class="spacer"></span>
        <button class="btn btn-primary" @onclick="NewMentor">+ Tambah Mentor</button>
    </div>

    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Nama</th><th>Keahlian</th><th>Pengalaman</th><th>Rating</th><th>Status</th><th>Aksi</th></tr>
            </thead>
            <tbody>
                @foreach (var m in _mentors)
                {
                    <tr>
                        <td><strong>@m.Name</strong><br /><span class="muted">@m.Title</span></td>
                        <td>@m.VehicleTypes</td>
                        <td>@m.ExperienceYears thn</td>
                        <td>⭐ @m.Rating.ToString("0.0", CultureInfo.InvariantCulture)</td>
                        <td><AdminBadge Value="@m.Status" /></td>
                        <td>
                            <div class="admin-actions">
                                <button class="btn btn-outline" @onclick="() => EditMentor(m)">Edit</button>
                                <button class="btn btn-outline" style="color:#dc2626;border-color:#fecaca" @onclick="() => DeleteMentor(m)">Hapus</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_mentors.Count == 0)
    {
        <p class="empty">Belum ada mentor.</p>
    }
</div>

@if (_editing is not null)
{
    <div class="admin-modal">
        <div class="admin-modal-box admin-modal-wide">
            <h3>@(_editing.Id == Guid.Empty ? "Tambah Mentor" : "Edit Mentor")</h3>
            <div class="form form-wide">
                <div class="two-col">
                    <div class="field"><label>Nama</label><input @bind="_form.Name" /></div>
                    <div class="field"><label>Title</label><input @bind="_form.Title" /></div>
                </div>
                <div class="two-col">
                    <div class="field"><label>Jenis Kendaraan (CSV)</label><input @bind="_form.VehicleTypes" placeholder="MOTOR,MOBIL" /></div>
                    <div class="field"><label>Telepon</label><input @bind="_form.Phone" /></div>
                </div>
                <div class="two-col">
                    <div class="field"><label>Tahun Pengalaman</label><input type="number" @bind="_form.ExperienceYears" /></div>
                    <div class="field"><label>Rating</label><input type="number" step="0.1" @bind="_form.Rating" /></div>
                </div>
                <div class="two-col">
                    <div class="field"><label>Murid Dibimbing</label><input type="number" @bind="_form.StudentsTrained" /></div>
                    <div class="field"><label>Status</label>
                        <select @bind="_form.Status">
                            <option value="ACTIVE">Aktif</option>
                            <option value="INACTIVE">Nonaktif</option>
                        </select>
                    </div>
                </div>
                <div class="field"><label>Bio</label><textarea @bind="_form.Bio" rows="3"></textarea></div>
                <div class="admin-actions" style="justify-content:flex-end">
                    <button class="btn btn-outline" @onclick="CancelEdit">Batal</button>
                    <button class="btn btn-primary" disabled="@_busy" @onclick="SaveMentor">Simpan</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AdminMentorDto> _mentors = new();
    private AdminMentorDto? _editing;
    private bool _busy;
    private string? _error;

    private AdminMentorUpsertRequest _form = new("", "", "", 0, 0, 0, "", "ACTIVE", null);

    private void NewMentor()
    {
        _editing = new AdminMentorDto(Guid.Empty, "", "", "", 0, 0, 0, "", "ACTIVE", null);
        _form = new AdminMentorUpsertRequest("", "", "", 0, 0, 0, "", "ACTIVE", null);
    }

    private void EditMentor(AdminMentorDto m)
    {
        _editing = m;
        _form = new AdminMentorUpsertRequest(
            m.Name, m.Title, m.VehicleTypes, m.ExperienceYears, m.Rating,
            m.StudentsTrained, m.Bio, m.Status, m.Phone);
    }

    private void CancelEdit() => _editing = null;

    private async Task SaveMentor()
    {
        _busy = true;
        _error = null;
        (bool Success, string? Error) result =
            _editing?.Id == Guid.Empty
                ? await Api.PostVoidAsync("/api/admin/mentors", _form)
                : await Api.PutVoidAsync($"/api/admin/mentors/{_editing!.Id}", _form);
        if (!result.Success) _error = result.Error;
        else
        {
            _editing = null;
            await Load();
        }
        _busy = false;
    }

    private async Task DeleteMentor(AdminMentorDto m)
    {
        _busy = true;
        _error = null;
        var result = await Api.DeleteVoidAsync($"/api/admin/mentors/{m.Id}");
        if (!result.Success) _error = result.Error;
        else await Load();
        _busy = false;
    }

    private async Task Load()
    {
        _mentors = await Api.GetAsync<List<AdminMentorDto>>("/api/admin/mentors") ?? new();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated || !Auth.IsAdmin)
        {
            Nav.NavigateTo("/admin/login", forceLoad: true);
            return;
        }
        await Load();
    }
}
