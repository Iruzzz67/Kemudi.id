@page "/materi/{Slug}"
@using Kemudi.Web.Data
@implements IDisposable

@if (_materi is null)
{
    <div class="empty">Materi tidak ditemukan. <a href="materi">Kembali ke daftar materi</a>.</div>
}
else
{
    <div class="detail-hero" style="flex-direction:column; align-items:flex-start; gap:1rem; padding:2.5rem;">
        <span class="card-tag" style="font-size:0.75rem;">@_materi.Category</span>
        <h1 style="font-size:2rem;">@_materi.Title</h1>
        <p style="font-size:1.05rem; max-width:600px;">@_materi.Summary</p>
    </div>

    <div class="card" style="padding:2.5rem; line-height:1.9;">
        @foreach (var para in _materi.Content)
        {
            <p style="font-size:1.05rem; margin:0 0 1.25rem;">@para</p>
        }
    </div>

    <div class="mt-4" style="display:flex; gap:0.75rem; padding-bottom:2rem;">
        <a class="btn btn-outline btn-lg" href="materi">← Semua Materi</a>
        <a class="btn btn-primary btn-lg" href="simulasi">🎮 Coba Simulasi</a>
    </div>
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;
    private Kemudi.Web.Data.Materi? _materi;

    protected override void OnInitialized() => _materi = MateriData.BySlug(Slug);

    public void Dispose() { }
}
