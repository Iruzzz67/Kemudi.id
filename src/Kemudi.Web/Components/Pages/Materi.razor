@page "/materi"
@using Kemudi.Web.Data

<section class="hero" style="padding-bottom:1rem;">
    <h1>Materi <span>Teori</span></h1>
    <p>
        Pelajari rambu lalu lintas dan dasar berkendara sebelum praktik.
        Materi lengkap dari aturan jalan hingga keselamatan berkendara.
    </p>
</section>

<div class="grid grid-2 mt-3">
    @foreach (var m in MateriData.List)
    {
        <a class="card" href="materi/@m.Slug" style="display:flex; flex-direction:column; gap:0.5rem;">
            <span class="card-tag">@m.Category</span>
            <h3 style="font-weight:800;">@m.Title</h3>
            <p>@m.Summary</p>
            <span style="color:var(--blue); font-size:0.85rem; font-weight:700; margin-top:auto; padding-top:0.75rem; display:inline-flex; align-items:center; gap:0.25rem;">
                Baca selengkapnya →
            </span>
        </a>
    }
</div>
