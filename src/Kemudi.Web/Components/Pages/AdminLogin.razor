@page "/admin/login"
@using Kemudi.Web.Services
@inject AuthService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="admin-login-wrap">
    <div class="admin-login-brand">Kemudi<span>.id</span></div>
    <div class="admin-login-sub">Admin Dashboard</div>

    <div class="admin-login-box">
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-box">@_error</div>
        }

        <div class="field">
            <label for="admin-login-email">Email</label>
            <input id="admin-login-email" type="email" autocomplete="username" @bind="_email" placeholder="admin@kemudi.id" />
        </div>

        <div class="field">
            <label for="admin-login-password">Password</label>
            <input id="admin-login-password" type="password" autocomplete="current-password" @bind="_password" />
        </div>

        <button class="btn btn-primary" disabled="@_busy" @onclick="LoginAsync">
            @(_busy ? "Memeriksa..." : "LOGIN ADMIN")
        </button>

        <div class="admin-login-hint">Area terbatas. Hanya akun dengan role ADMIN yang dapat mengakses.</div>
    </div>

    <a href="" style="margin-top:1.25rem;color:#64748b;font-size:0.85rem">← Kembali ke Kemudi.id</a>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        if (await Auth.LoadAdminAsync())
            Nav.NavigateTo("/admin/dashboard", forceLoad: true);
        else if (Auth.AdminAccessError is not null)
            _error = Auth.AdminAccessError;
    }

    private async Task LoginAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
            {
                _error = "Email dan password wajib diisi.";
                return;
            }
            await using var session = await JS.InvokeAsync<IJSObjectReference>("import", "/js/session-client.js");
            _error = await session.InvokeAsync<string?>("submit", "admin-login", new { email = _email, password = _password });
            if (_error is null)
                Nav.NavigateTo("/admin/dashboard", forceLoad: true);
        }
        catch (JSException)
        {
            _error = "Layanan login belum dapat dihubungi. Coba lagi.";
        }
        finally
        {
            _busy = false;
        }
    }
}
