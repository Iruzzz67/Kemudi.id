@page "/admin/login"
@using Kemudi.Web.Services
@inject AuthService Auth
@inject NavigationManager Nav

<div class="admin-login-wrap">
    <div class="admin-login-brand">Kemudi<span>.id</span></div>
    <div class="admin-login-sub">Admin Dashboard</div>

    <div class="admin-login-box">
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-box">@_error</div>
        }

        <div class="field">
            <label>Email</label>
            <input type="email" @bind="_email" placeholder="admin@kemudi.id" />
        </div>

        <div class="field">
            <label>Password</label>
            <input type="password" @bind="_password" />
        </div>

        <button class="btn btn-primary" disabled="@_busy" @onclick="LoginAsync">
            @(_busy ? "Memeriksa..." : "LOGIN ADMIN")
        </button>

        <div class="admin-login-hint">Area terbatas. Hanya akun dengan role ADMIN yang dapat mengakses.</div>
    </div>

    <a href="" style="margin-top:1.25rem;color:#64748b;font-size:0.85rem">← Kembali ke Kemudi.id</a>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    protected override void OnInitialized()
    {
        // Admin yang sudah login langsung diarahkan ke dashboard.
        if (Auth.IsAuthenticated && Auth.IsAdmin)
            Nav.NavigateTo("/admin/dashboard", forceLoad: true);
    }

    private async Task LoginAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Auth.LoginAdminAsync(_email, _password);
            if (result.Success)
                Nav.NavigateTo("/admin/dashboard", forceLoad: true);
            else
                _error = result.Error;
        }
        finally
        {
            _busy = false;
        }
    }
}
